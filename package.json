{
  "name": "instamint-project",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently --kill-others \"npm run start:back\" \"npm run start:front\"",
    "start:back": "cd instamint-back && npm run start:dev",
    "start:front": "cd instamint-front && ng serve"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "jwt-decode": "^4.0.0"
  }
}
